NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/messaging_warmup
REDIS_URL=redis://localhost:6379
WEBHOOK_PROVIDER_URL=https://provider.example.com/messages
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_MAX_DAILY_QUOTA=500
HEALTH_WINDOW_DAYS=7
