{
  "name": "phone-health-rampup-service",
  "version": "1.0.2",
  "description": "Phone number health scoring and warm-up service for B2B messaging.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "dev:webhook": "tsx src/devWebhook.ts",
    "migrate": "tsx src/db/migrate.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.19"
  }
}
